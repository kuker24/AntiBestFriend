#!/usr/bin/env bash
set -euo pipefail
umask 077

resolve_runtime_root() {
  local managed="${GBFC_MANAGED:-$HOME/.gemini/antigravity-bestfriend}"
  if [[ -f "$managed/lib/common.sh" ]]; then
    printf '%s\n' "$managed"
    return 0
  fi
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd -- "$(dirname -- "$src")" && pwd)"
    src="$(readlink -- "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -- "$(dirname -- "$src")/.." && pwd
}

ROOT="$(resolve_runtime_root)"
if [[ ! -f "$ROOT/lib/common.sh" ]]; then
  printf 'ERROR: Cannot resolve AntiBestFriend runtime root\n' >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$ROOT/lib/common.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/transaction.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/wrapper.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/design-bank.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/tools.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/skills.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/doctor.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/restore.sh"

cmd="${1:-}"
shift || true
case "$cmd" in
  doctor)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repair) GBFC_REPAIR=1 ;;
        --strict) GBFC_DOCTOR_STRICT=1 ;;
        *) gbfc_die "unknown doctor flag $1" ;;
      esac
      shift
    done
    gbfc_doctor
    ;;
  install)
    if [[ -f "$GBFC_ROOT/install.sh" ]]; then
      exec "$GBFC_ROOT/install.sh" "$@"
    else
      exec "$ROOT/lib/install.sh" "$@"
    fi
    ;;
  uninstall)
    if [[ -f "$GBFC_ROOT/uninstall.sh" ]]; then
      exec "$GBFC_ROOT/uninstall.sh" "$@"
    elif [[ -f "$ROOT/uninstall.sh" ]]; then
      exec "$ROOT/uninstall.sh" "$@"
    else
      gbfc_die "uninstall script not found"
    fi
    ;;
  restore)
    if [[ "${1:-}" == "--list" ]]; then
      gbfc_list_backups
      exit 0
    fi
    stamp="${1:-}"
    gbfc_lock_begin
    trap 'gbfc_lock_end' EXIT
    gbfc_restore_backup "$stamp"
    ;;
  skills)
    case "${1:-}" in
      list)
        ls -1 "$GBFC_PLUGIN_DIR/skills" 2>/dev/null || ls -1 "$GBFC_MANAGED/skills" 2>/dev/null || ls -1 "$ROOT/vendor/skills"
        ;;
      verify)
        python3 "$ROOT/lib/validate_skills.py" \
          --skills "$GBFC_PLUGIN_DIR/skills" \
          --allowlist "$GBFC_MANAGED/vendor/skill-allowlist.txt" \
          --policy "$GBFC_MANAGED/vendor/skill-policy.json"
        ;;
      *) echo "Usage: agy-bestfriend skills list|verify" >&2; exit 2 ;;
    esac
    ;;
  mcp)
    case "${1:-}" in
      status|list)
        python3 "$ROOT/lib/mcp.py" classify-all --policy "$GBFC_MANAGED/vendor/mcp-policy.json"
        ;;
      repair|add)
        python3 "$ROOT/lib/mcp.py" add --name "${2:-}" --policy "$GBFC_MANAGED/vendor/mcp-policy.json"
        ;;
      remove)
        python3 "$ROOT/lib/mcp.py" remove --name "${2:-}"
        ;;
      *) echo "Usage: agy-bestfriend mcp status|add <name>|remove <name>" >&2; exit 2 ;;
    esac
    ;;
  wrapper)
    case "${1:-}" in
      status) gbfc_wrapper_status ;;
      repair) gbfc_wrapper_repair ;;
      refresh) gbfc_wrapper_refresh ;;
      *) echo "Usage: agy-bestfriend wrapper status|repair|refresh" >&2; exit 2 ;;
    esac
    ;;
  design-bank)
    case "${1:-}" in
      status)
        if bank="$(gbfc_discover_design_bank)"; then
          echo "Design Bank: $bank"
        else
          echo "Design Bank: NOT_CONFIGURED"
        fi
        ;;
      rediscover) gbfc_design_bank_rediscover ;;
      *) echo "Usage: agy-bestfriend design-bank status|rediscover" >&2; exit 2 ;;
    esac
    ;;
  design-intelligence)
    python3 "$ROOT/scripts/design-intelligence.py" "$@"
    ;;
  serena)
    case "${1:-}" in
      status)
        python3 "$ROOT/lib/mcp.py" classify --name serena --policy "$GBFC_MANAGED/vendor/mcp-policy.json"
        ;;
      enable)
        python3 "$ROOT/lib/mcp.py" add --name serena --policy "$GBFC_MANAGED/vendor/mcp-policy.json" --enable
        echo "serena MCP enabled in Antigravity."
        ;;
      disable)
        python3 "$ROOT/lib/mcp.py" add --name serena --policy "$GBFC_MANAGED/vendor/mcp-policy.json" --disable
        echo "serena MCP disabled."
        ;;
      *) echo "Usage: agy-bestfriend serena status|enable|disable" >&2; exit 2 ;;
    esac
    ;;
  chromium)
    exec "$GBFC_CDP" "$@"
    ;;
  context-guard)
    if [[ $# -eq 0 ]]; then
      exec "$GBFC_CONTEXT_GUARD" status
    fi
    exec "$GBFC_CONTEXT_GUARD" "$@"
    ;;
  ""|-h|--help)
    cat <<'HELP_EOF'
agy-bestfriend doctor [--repair] [--strict]
agy-bestfriend install [--dry-run]
agy-bestfriend uninstall
agy-bestfriend restore [--list|STAMP]
agy-bestfriend skills list|verify
agy-bestfriend mcp status|add|remove
agy-bestfriend wrapper status|repair|refresh
agy-bestfriend design-bank status|rediscover
agy-bestfriend design-intelligence status|doctor|search|shortlist
agy-bestfriend serena status|enable|disable
agy-bestfriend chromium start|status|stop|resolve
agy-bestfriend context-guard status|self-test|cache|prune
HELP_EOF
    ;;
  *)
    gbfc_die "Unknown command: $cmd"
    ;;
esac
