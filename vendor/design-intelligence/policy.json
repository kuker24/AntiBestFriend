{
  "schema_version": 1,
  "catalog_schema_version": 1,
  "keep_generations": 2,
  "zip": {
    "max_members": 20000,
    "max_member_uncompressed": 52428800,
    "max_total_uncompressed": 2147483648,
    "max_compression_ratio": 200,
    "max_read_bytes": 1048576
