{
  "context-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "@CONTEXT_GUARD_BIN@",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "@CONTEXT_GUARD_BIN@",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "@CONTEXT_GUARD_BIN@",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "@CONTEXT_GUARD_BIN@",
        "timeout": 15
      }
    ]
  }
}
