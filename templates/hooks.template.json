{
  "context-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file|generate_image|read_browser_page|read_image",
        "hooks": [
          {
            "type": "command",
            "command": "@CONTEXT_GUARD_BIN@",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
